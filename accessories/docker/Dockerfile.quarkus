# ==============================================================================
# Dockerfile for EDS Quarkus Application
# ------------------------------------------------------------------------------
# Runs the EDS Quarkus
# ==============================================================================

FROM eclipse-temurin:25-jre-alpine

LABEL maintainer="EDS Project"
LABEL description="EDS Quarkus Application"

# Set timezone
ENV TZ=Europe/Berlin
RUN apk add --no-cache tzdata \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone

# Create app directory and non-root user
RUN addgroup -S eds && adduser -S eds -G eds
WORKDIR /app

# Copy the pre-built uber-jar
COPY eds-quarkus/target/eds-runnable.jar /app/eds-runnable.jar

# Create logs directory
RUN mkdir -p /app/logs

# Set ownership
RUN chown -R eds:eds /app

# Switch to non-root user
USER eds

# Expose the application port, and the management port (health endpoints),
# which must only be reachable by the orchestrator, not published publicly.
EXPOSE 8080
EXPOSE 9000

# Health check, using the MicroProfile readiness endpoint on the management
# port. It reports UP (HTTP 200) only when both the database and EDS are
# ready, otherwise HTTP 503. Plain HTTP, so it also works when the
# application port is TLS-only (EDS_INSECURE_REQUESTS=disabled).
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -q -T 4 -O /dev/null http://localhost:9000/q/health/ready || exit 1

# Run the application
ENTRYPOINT ["java", "-jar", "/app/eds-runnable.jar"]
