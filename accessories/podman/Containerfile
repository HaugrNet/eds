# ==============================================================================
# Containerfile for the EDS Quarkus Application
# ------------------------------------------------------------------------------
# Runs the EDS uber-jar, which must be built first. The build context is the
# eds-quarkus/target folder, and the image must be built in the Docker format,
# as the OCI format doesn't support the HEALTHCHECK instruction:
#
#   podman build --format docker -f accessories/podman/Containerfile \
#       -t eds-quarkus:local eds-quarkus/target
#
# Or simply: ./eds.sh build --containers
# ==============================================================================

FROM docker.io/library/eclipse-temurin:25-jre-alpine

LABEL maintainer="EDS Project"
LABEL description="EDS Quarkus Application"

# Set timezone
ENV TZ=Europe/Berlin
RUN apk add --no-cache tzdata \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone

# Create app directory and non-root user. The fixed UID and GID allow the
# user to be mapped to the host user, so the logs are owned by the host user.
RUN addgroup -S -g 1001 eds && adduser -S -u 1001 -G eds eds
WORKDIR /app

# Copy the pre-built uber-jar, the build context is eds-quarkus/target
COPY eds-runnable.jar /app/eds-runnable.jar

# Create logs directory
RUN mkdir -p /app/logs

# Set ownership
RUN chown -R eds:eds /app

# Switch to non-root user
USER eds

# Expose the application port, and the management port (health endpoints),
# which must only be reachable by the orchestrator, not published publicly.
EXPOSE 8080
EXPOSE 9000

# Health check, using the MicroProfile readiness endpoint on the management
# port. It reports UP (HTTP 200) only when both the database and EDS are
# ready, otherwise HTTP 503. Plain HTTP, so it also works when the
# application port is TLS-only (EDS_INSECURE_REQUESTS=disabled).
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -q -T 4 -O /dev/null http://localhost:9000/q/health/ready || exit 1

# Run the application
ENTRYPOINT ["java", "-jar", "/app/eds-runnable.jar"]
