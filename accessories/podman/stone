#!/bin/bash
# ==============================================================================
# stone - runs an EDS stone on a host
# ------------------------------------------------------------------------------
# Sets up and controls one EDS container on the host it runs on: the stone
# alone, which serves the API. It needs
# nothing of the EDS sources, only this file and a container image, so it can
# be copied to a directory of the PATH, e.g. ~/.local/bin/stone.
#
# Everything it does is done as the user who runs it, with rootless Podman: it
# never asks for root, and never calls sudo. What must be changed in the
# system (installing Podman or PostgreSQL, a reverse proxy, start at boot) is
# told by 'stone help <topic>' and 'stone check', marked with [ROOT], and is
# left to whoever has the rights. Run without arguments for the help.
#
# A host may run several stones, each an instance with a name: 'stone -i north
# start'. An instance has its own settings, MasterKey, logs, container and
# service. Without a name it is the default instance, which is all a host
# with one stone needs.
# ==============================================================================

program="$(basename "${0}")"
readonly program

# The instance: -i <name> before the command, or STONE_INSTANCE. None is the
# default instance.
instance="${STONE_INSTANCE:-}"
while true; do
    case "${1:-}" in
        -i | --instance)
            if [[ $# -lt 2 ]]; then
                echo "${1} needs the name of an instance."
                exit 1
            fi
            instance="${2}"
            shift 2
            ;;
        --instance=*)
            instance="${1#*=}"
            shift
            ;;
        *) break ;;
    esac
done
[[ "${instance}" == default ]] && instance=""
if [[ -n "${instance}" ]]; then
    # It becomes part of the names of a directory, a container and a service
    if [[ ! "${instance}" =~ ^[a-z0-9][a-z0-9-]{0,30}$ || "${instance}" == certs || "${instance}" == logs ]]; then
        echo "'${instance}' can't be the name of an instance: use small letters, digits and"
        echo "'-', at most 31 characters; 'certs' and 'logs' are taken."
        exit 1
    fi
fi
readonly instance

# How this instance is called, as the hints of this script tell it
script="${program}"
[[ -n "${instance}" ]] && script+=" -i ${instance}"
readonly script

# Where the settings and the logs are; both are only the user's own. A named
# instance has a directory of its own below those of the default instance.
readonly stoneBase="${STONE_HOME:-${XDG_CONFIG_HOME:-${HOME}/.config}/stone}"
readonly stateBase="${STONE_STATE:-${XDG_STATE_HOME:-${HOME}/.local/state}/stone}"
readonly stoneHome="${stoneBase}${instance:+/${instance}}"
readonly stoneState="${stateBase}${instance:+/${instance}}"
# The name of its container, unless STONE_NAME tells another, and of its service
readonly unitName="stone${instance:+-${instance}}"
readonly envFile="${stoneHome}/stone.env"
readonly masterKeyFile="${stoneHome}/masterkey"
readonly certsDir="${stoneHome}/certs"
readonly logsDir="${stoneState}/logs"
readonly masterKeyMount="/run/secrets/eds-masterkey"
readonly unitDir="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user"
readonly unitFile="${unitDir}/${unitName}.service"

# The image, as 'eds.sh build stone' names it, and the label it carries
readonly stoneImage="eds-stone:local"
readonly edsLabel="maintainer=EDS Project"

# ==============================================================================
# Settings
# ------------------------------------------------------------------------------
# The settings file is read, never executed, so a password may hold any
# character. A variable of the environment takes precedence over the file.
#   $1 = name, $2 = default
# ==============================================================================
function setting() {
    local name="${1}" value=""
    if [[ -n "${!name+set}" ]]; then
        echo "${!name}"
        return
    fi
    [[ -f "${envFile}" ]] && value=$(sed -n "s/^${name}=//p" "${envFile}" | tail -n 1)
    echo "${value:-${2:-}}"
}

# The name of this instance, for a person
#   $1 = anything, for the start of a sentence
function instanceName() {
    local the="the"
    [[ -n "${1:-}" ]] && the="The"
    echo "${the} stone${instance:+ '${instance}'}"
}

function isEnabled() {
    command -v systemctl > /dev/null 2>&1 && systemctl --user is-enabled "${unitName}.service" > /dev/null 2>&1
}

# The value of a setting in the settings file of any instance
#   $1 = settings file, $2 = name, $3 = default
function settingIn() {
    local value=""
    [[ -f "${1}" ]] && value=$(sed -n "s/^${2}=//p" "${1}" | tail -n 1)
    echo "${value:-${3:-}}"
}

# The instances of this user which have settings: an empty line for the
# default instance, and the names of the others
function instances() {
    [[ -f "${stoneBase}/stone.env" ]] && echo ""
    local file
    for file in "${stoneBase}"/*/stone.env; do
        [[ -f "${file}" ]] && basename "$(dirname "${file}")"
    done
}

function image() {
    setting STONE_IMAGE "${stoneImage}"
}

function containerName() { setting STONE_NAME "${unitName}"; }
function bindAddress() { setting STONE_BIND 127.0.0.1; }
function port() { setting STONE_PORT 8080; }
function tlsPort() { setting STONE_TLS_PORT 8443; }

# The address at which this host itself reaches the stone
function localAddress() {
    local address
    address=$(bindAddress)
    case "${address}" in
        0.0.0.0 | "") echo "127.0.0.1" ;;
        *) echo "${address}" ;;
    esac
}

function apiUrl() { echo "http://$(localAddress):$(port)/api/v1"; }

# ==============================================================================
# Common helpers
# ==============================================================================
function usageError() {
    echo "${1}"
    echo "Run '${script}' without arguments for the help."
    return 1
}

function ok() { echo "  [OK]   ${1}"; }
function missing() { echo "  [--]   ${1}"; }

# What is still to do, and who can do it: [USER] is you, [ROOT] needs root
function todoUser() { echo "         [USER] ${1}"; }
function todoRoot() { echo "         [ROOT] ${1}"; }

function needPodman() {
    command -v podman > /dev/null 2>&1 && return 0
    echo "Podman is not installed. Installing it changes the system and needs root,"
    echo "see '${script} help podman'."
    return 1
}

function isRunning() {
    [[ "$(podman container inspect -f '{{.State.Running}}' "$(containerName)" 2>/dev/null)" == "true" ]]
}

function containerExists() {
    podman container exists "$(containerName)" 2>/dev/null
}

function imageExists() {
    podman image exists "${1}" 2>/dev/null
}

# Runs wget in the container, which reaches the ports the host doesn't
function inContainer() {
    podman exec "$(containerName)" wget -q -T 4 -O - "$@" 2>/dev/null
}

function isReady() {
    inContainer "http://localhost:9000/q/health/ready" | grep -qE '"status":\s*"UP"'
}

# Prints the version of the running EDS, or nothing if it doesn't answer
function edsVersion() {
    inContainer --header "Content-Type: application/json" --post-data '{}' \
        "http://localhost:8080/api/v1/version" | grep -o '"version":"[^"]*"' | cut -d'"' -f4
}

# Asks before something is removed, unless --yes was given
#   $1 = true if --yes was given, $2 = question
function confirmed() {
    [[ "${1}" == true ]] && return 0
    local answer
    read -r -p "${2} [y/N] " answer
    [[ "${answer}" == y || "${answer}" == Y || "${answer}" == yes ]]
}

