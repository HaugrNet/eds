# Prints a help topic, with the names of this host and user filled in
function topic() {
    sed -e "s|@SCRIPT@|${script}|g" -e "s|@PROGRAM@|${program}|g" -e "s|@UNIT@|${unitName}|g" \
        -e "s|@USER@|${USER:-$(id -un)}|g" \
        -e "s|@HOME@|${stoneHome}|g" -e "s|@ENV@|${envFile}|g" \
        -e "s|@PORT@|$(port)|g" -e "s|@LOGS@|${logsDir}|g"
}

function helpTopic() {
    case "${1:-}" in
        "") showHelp ;;
        setup) helpSetup ;;
        podman) helpPodman ;;
        images) helpImages ;;
        settings) helpSettings ;;
        postgresql | postgres | database) helpPostgresql ;;
        masterkey) helpMasterKey ;;
        tls) helpTls ;;
        proxy | reverse-proxy) helpProxy ;;
        boot) helpBoot ;;
        instances | instance) helpInstances ;;
        cleanup) helpCleanup ;;
        *) usageError "Unknown help topic: ${1}" ;;
    esac
}

function helpSetup() {
    topic <<'EOF'
Setting up a stone, step by step

  A line with '#' is run as root and changes the system; a line with '$' is
  run as you (@USER@). After the steps marked [ROOT], which are done once,
  everything is done as you.

  1. [ROOT] Podman, for your user                    @SCRIPT@ help podman
  2. [ROOT] A PostgreSQL database for the stone      @SCRIPT@ help postgresql
            Without one, the stone keeps everything in memory and loses it
            when it stops: fine to try it, never for real use.
  3.        The image, brought to this host          @SCRIPT@ help images
              $ @SCRIPT@ load eds-stone.tar
  4.        The settings
              $ @SCRIPT@ init
            Then put the database into @ENV@,
            see '@SCRIPT@ help settings'.
  5.        The MasterKey                            @SCRIPT@ help masterkey
              $ @SCRIPT@ masterkey generate
  6.        Look at what is in place
              $ @SCRIPT@ check
  7.        Start it
              $ @SCRIPT@ start
              $ @SCRIPT@ status
  8. [ROOT] HTTPS for the world outside              @SCRIPT@ help proxy
            (or by the stone itself, without root:   @SCRIPT@ help tls)
  9. [ROOT, once] Start with the host                @SCRIPT@ help boot
              $ @SCRIPT@ enable

  For more than one stone on this host, each is given a name, and the steps
  3 to 9 are done for each: see '@SCRIPT@ help instances'.

  A new stone has no account, and sets no name for one: whoever comes to
  it first becomes its System Administrator, under the account name and
  with the passphrase given. So choose the name, 'admin' or any other, and
  be the first: right after the first start, before the stone is reachable
  from outside, with '@SCRIPT@ masterkey load' or the MasterKey request.
EOF
}

function helpPodman() {
    topic <<'EOF'
Podman for your user                                                    [ROOT]

  The stone runs in a rootless container: Podman is installed once, by
  root, and from then on used by you without any rights.

  AS ROOT - this changes the system:

    Debian, Ubuntu:
      # apt install podman
    Fedora, RHEL, Rocky, Alma:
      # dnf install podman

    A rootless container needs a range of subordinate user and group ids for
    your user. Most systems give one to every new user; if '@SCRIPT@ check'
    says it is missing:
      # usermod --add-subuids 100000-165535 --add-subgids 100000-165535 @USER@

    Only if the stone is to listen on a port below 1024 itself, without a
    reverse proxy in front of it (ports from 80 on, for all users):
      # sysctl -w net.ipv4.ip_unprivileged_port_start=80
      # echo 'net.ipv4.ip_unprivileged_port_start=80' > /etc/sysctl.d/50-stone.conf

  AS YOU:

      $ podman info                 It answers without an error
      $ podman system migrate       After a change of the id ranges
      $ @SCRIPT@ check
EOF
}

