# ==============================================================================
# EDS Build Container
# ------------------------------------------------------------------------------
# Used by "eds.sh build --podman" to run the Maven build without a local Java.
# The project and the local Maven repository are mounted at run time, and the
# Maven Wrapper of the project is used, so the image only holds the JDK.
# ==============================================================================
FROM docker.io/library/eclipse-temurin:25-jdk-alpine
LABEL maintainer="EDS Project"
LABEL description="EDS Build Container"
WORKDIR /app
CMD ["./mvnw", "-B", "-ntp", "-DskipTests", "clean", "install"]
