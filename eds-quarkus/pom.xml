<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.haugr</groupId>
        <artifactId>eds</artifactId>
        <version>2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>eds-quarkus</artifactId>
    <packaging>jar</packaging>
    <name>EDS - Quarkus</name>
    <description>Quarkus runtime module, which selects PostgreSQL or the in-memory H2 database at startup</description>

    <properties>
        <contract.dir>${project.build.directory}/contract</contract.dir>
        <webui.dir>${project.basedir}/src/main/webui</webui.dir>
        <!-- The stone alone (-Dstone) is built in a folder of its own,
             target/stone, so its build doesn't remove the JAR of the EDS with
             Rune; its JAR is written beside that one, in target -->
        <eds.build.dir>${project.basedir}/target</eds.build.dir>
        <eds.stone>false</eds.stone>
        <quarkus.package.output-name>eds-rune</quarkus.package.output-name>
        <!-- The MasterKey source of the tests, see the surefire plugin below -->
        <test.masterkey.url>file://${project.basedir}/src/test/resources/test-masterkey.txt</test.masterkey.url>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Override parent pom's Hibernate 6.x with the version used by the Quarkus BOM -->
            <dependency>
                <groupId>org.hibernate.orm</groupId>
                <artifactId>hibernate-core</artifactId>
                <version>${version.hibernate-core.quarkus}</version>
            </dependency>
            <!-- Override parent pom's JUnit 5.x with the version used by the Quarkus BOM -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${version.junit.quarkus}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-params</artifactId>
                <version>${version.junit.quarkus}</version>
            </dependency>
            <!-- Import Quarkus BOM -->
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${version.quarkus}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- EDS Core module, containing JAX-RS & logic -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>eds-core</artifactId>
        </dependency>
        <!-- Also reached through eds-core; named here so the merged coverage
             report (jacoco report-aggregate, below) includes eds-api. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>eds-api</artifactId>
        </dependency>

        <!-- Quarkus Core -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <!-- Jakarta WebSocket, for the chat endpoint of eds-core (PLAN.md, L4) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-websockets</artifactId>
        </dependency>

        <!-- If using JPA in core: provide ORM and JDBC driver; user can add configuration later -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm</artifactId>
        </dependency>
        <!-- Hibernate Core - version managed in dependencyManagement -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
        </dependency>
        <!-- Logging API compatibility -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Both JDBC Drivers are included, the database is selected at startup -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
        </dependency>
        
        <!-- Test -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Quarkus rewrites the classes of this module as it loads them,
             so the JaCoCo agent doesn't recognise them; this extension
             measures them in the @QuarkusTest tests (target/jacoco-quarkus.exec,
             merged by the report-aggregate below). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jacoco</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <directory>${eds.build.dir}</directory>
        <plugins>
            <!-- The Quarkus tests require the JBoss Log Manager -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <!-- Test-only MasterKey source; without one, EDS stays locked -->
                        <eds.masterkey.url>${test.masterkey.url}</eds.masterkey.url>
                        <!-- Which of the two was built: EdsPwaTest or EdsStoneTest -->
                        <eds.stone>${eds.stone}</eds.stone>
                        <!-- The merged report is made by report-aggregate -->
                        <quarkus.jacoco.report>false</quarkus.jacoco.report>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${version.quarkus}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <skip>false</skip>
                    <ignoredEntries>
                        <ignoredEntry>META-INF/quarkus-config-doc/quarkus-config-model-version</ignoredEntry>
                        <ignoredEntry>META-INF/quarkus-config-doc/quarkus-config-model.json</ignoredEntry>
                        <ignoredEntry>META-INF/maven/org.jctools/jctools-core/pom.properties</ignoredEntry>
                    </ignoredEntries>
                </configuration>
            </plugin>
            <!-- The tests here reach eds-core and eds-api through REST and
                 the socket, so their coverage is merged with that of the
                 tests of those modules. SonarQube reads the merged report,
                 see sonar.coverage.jacoco.xmlReportPaths in the root pom. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/target/jacoco-aggregate</outputDirectory>
                            <includeCurrentProject>true</includeCurrentProject>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>quarkus</id>
            <activation>
                <property>
                    <name>quarkus.profile</name>
                </property>
            </activation>
        </profile>
        <!-- Rune, the PWA (RUNE.md): Quinoa builds it from src/main/webui and
             serves it at the root (/). It is part of the EDS JAR unless the
             stone alone is built (-Dstone), which then holds neither Rune
             nor Quinoa. -->
        <profile>
            <id>rune</id>
            <activation>
                <property>
                    <name>!stone</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.quarkiverse.quinoa</groupId>
                    <artifactId>quarkus-quinoa</artifactId>
                    <version>${version.quinoa}</version>
                </dependency>
            </dependencies>
            <build>
                <!-- The settings of Quinoa, beside the resources of the stone -->
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                    </resource>
                    <resource>
                        <directory>src/main/rune</directory>
                    </resource>
                </resources>
                <plugins>
                    <!-- The TypeScript client of the PWA is generated from the contract
                         in eds-api, before Quinoa builds the PWA -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>${version.maven-dependency-plugin}</version>
                        <executions>
                            <execution>
                                <id>unpack-contract</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>unpack</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>${project.groupId}</groupId>
                                            <artifactId>eds-api</artifactId>
                                            <version>${project.version}</version>
                                            <includes>openapi.json</includes>
                                            <outputDirectory>${contract.dir}</outputDirectory>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.openapitools</groupId>
                        <artifactId>openapi-generator-maven-plugin</artifactId>
                        <version>${version.openapi-generator}</version>
                        <executions>
                            <execution>
                                <id>generate-typescript-client</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <inputSpec>${contract.dir}/openapi.json</inputSpec>
                                    <generatorName>typescript-fetch</generatorName>
                                    <output>${webui.dir}/src/api</output>
                                    <generateApiTests>false</generateApiTests>
                                    <generateModelTests>false</generateModelTests>
                                    <generateApiDocumentation>false</generateApiDocumentation>
                                    <generateModelDocumentation>false</generateModelDocumentation>
                                    <openapiNormalizer>REF_AS_PARENT_IN_ALLOF=true</openapiNormalizer>
                                    <configOptions>
                                        <supportsES6>true</supportsES6>
                                        <useSingleRequestParameter>true</useSingleRequestParameter>
                                        <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                    </configOptions>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- The stone alone: the REST API and the chat, without a web app.
             Built to target/eds-stone.jar with: mvn -Dstone -pl eds-quarkus package -->
        <profile>
            <id>stone</id>
            <activation>
                <property>
                    <name>stone</name>
                </property>
            </activation>
            <properties>
                <eds.build.dir>${project.basedir}/target/stone</eds.build.dir>
                <eds.stone>true</eds.stone>
                <quarkus.package.output-name>eds-stone</quarkus.package.output-name>
                <quarkus.package.output-directory>${project.basedir}/target</quarkus.package.output-directory>
            </properties>
        </profile>
    </profiles>

</project>
